# Which vehicle-data provider backs VIN decode and the year/make/model lists.
#
#   local  (default) — offline: local WMI table + bundled catalog. No network.
#   vpic             — NHTSA vPIC. Free, no API key. Adds model + trim decoding
#                      from the VIN, which the offline path cannot do. Falls
#                      back to `local` on any error.
VEHICLE_DATA_PROVIDER=local

# Password for the /admin schedule page. CHANGE THIS before going live.
ADMIN_PASSWORD=shank-admin

# Signs the admin session cookie. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Where the JSON appointment book lives (default ./data). The scaffold stores
# appointments on disk — swap src/lib/appointment-store.ts for a database
# before production (see README).
# DATA_DIR=

# Public site origin, used for absolute og:image / share-card URLs.
# Build-time. Defaults to the Render static site from render.yaml.
# NEXT_PUBLIC_SITE_URL=https://shank-auto.onrender.com

# TODO — not wired up yet (estimate requests are only logged, see
# src/app/api/estimates/route.ts):
# DATABASE_URL=
# RESEND_API_KEY=
# OWNER_EMAIL=
